SOURCES=lab03a-main.c lab03a-sum.c
OBJECTS=$(SOURCES:.c=.o)
HEADERS=lab03a-stuff.h
EXECUTABLE=sum

# CC, CFLAGS, CPPFLAGS, LDFLAGS - taken from environment variables

all : $(EXECUTABLE)

$(EXECUTABLE) : $(OBJECTS)
	$(CC) $(LDFLAGS) $^ -o $@
	#gcc $(OBJECTS) -o $(EXECUTABLE)

%.o : %.c $(HEADERS)
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@

clean :
	rm -f $(OBJECTS) $(EXECUTABLE)

