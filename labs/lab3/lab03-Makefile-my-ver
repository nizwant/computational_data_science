all : sum

sum : lab03a-main.o lab03a-sum.o
	gcc lab03a-main.o lab03a-sum.o -o sum

lab03a-main.o : lab03a-main.c lab03a-stuff.h
	gcc -c lab03a-main.c -o lab03a-main.o

lab03a-sum.o : lab03a-sum.c lab03a-stuff.h
	gcc -c lab03a-sum.c -o lab03a-sum.o

clean :
	rm -f lab03a-sum.o lab03a-main.o sum

# I had to do my own version with the original content of makefile because mac doesnt have extra environmental variables like CC, CFLAGS, CPPFLAGS, LDFLAGS
